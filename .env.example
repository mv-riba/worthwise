# Copy this file to .env.local and fill in the values.
# (`neon deploy` writes DATABASE_URL for you.)

# Neon Postgres connection string (use the POOLED one, with "-pooler" in the host)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Neon Auth: Neon Console → your project → Auth → copy the Auth URL
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.eu-central-1.aws.neon.tech/neondb/auth

# Any random text of 32+ characters. Make one with:  openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-me-with-a-long-random-secret-string

# Optional: Statistics Finland tables used for Finnish property estimates
# FI_APARTMENTS_TABLE=StatFin/ashi/15iq.px
# FI_HOUSES_TABLE=StatFin/kihi/15hx.px
